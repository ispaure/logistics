{
  "schema": 1,
  "suites": [
    {
      "id": "commonutils",
      "owner": "Python/commonUtils",
      "directory": "tests",
      "groups": [
        "desktop",
        "mobile-host"
      ],
      "interpreter": "desktop",
      "timeout": 1800,
      "smoke_args": [
        "--profile",
        "smoke",
        "--mode",
        "fast"
      ]
    },
    {
      "id": "logistics",
      "directory": "Python/tests",
      "groups": [
        "desktop"
      ],
      "after": [
        "commonutils"
      ],
      "interpreter": "desktop",
      "timeout": 1800,
      "smoke_args": [
        "--profile",
        "smoke",
        "--mode",
        "fast"
      ]
    },
    {
      "id": "portable-contracts",
      "directory": "Python/tests/tooling",
      "groups": [
        "mobile-host"
      ],
      "after": [
        "commonutils"
      ],
      "interpreter": "desktop",
      "smoke_args": [
        "--profile",
        "smoke",
        "--mode",
        "fast"
      ]
    },
    {
      "id": "desktop-ui",
      "directory": "Python/tests/application",
      "groups": [
        "mobile-host"
      ],
      "after": [
        "commonutils"
      ],
      "interpreter": "desktop",
      "smoke_args": [
        "--profile",
        "smoke",
        "--mode",
        "fast"
      ]
    },
    {
      "id": "mobile-host",
      "directory": "mobile_build/tests",
      "groups": [
        "mobile-host"
      ],
      "after": [
        "commonutils"
      ],
      "interpreter": "mobile",
      "smoke_args": [
        "--profile",
        "smoke",
        "--mode",
        "fast"
      ]
    }
  ],
  "test_structure": {
    "command": [
      "-m",
      "logistics_build.test_structure",
      "--check"
    ],
    "interpreter": "desktop"
  }
}
