<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.ispaure.logisticsoutgoingreceiver">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36"/>
  <application android:label="Logistics QA Receiver" android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:allowBackup="false" android:debuggable="true">
    <activity android:name=".OutgoingReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="application/octet-stream"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
