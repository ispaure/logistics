{
  "schema": 1,
  "adapter_api": 1,
  "project_id": "io.github.ispaure.logistics",
  "name": "Logistics",
  "interpreter": {
    "darwin": ".venv/bin/python",
    "linux": ".venv/bin/python",
    "win32": ".venv/Scripts/python.exe"
  },
  "bridge": "Scripts/manager_bridge.py",
  "results": "test-results/build-manager",
  "capabilities": {
    "platforms": [
      "macos",
      "linux",
      "windows",
      "ios",
      "android"
    ],
    "operations": [
      "Test",
      "Build",
      "Prepare TestFlight",
      "Prepare Firebase",
      "Reviewed TestFlight workflow",
      "Reviewed Firebase workflow",
      "Release"
    ],
