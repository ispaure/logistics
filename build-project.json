          "Prepare Firebase": [
            "This Linux host",
            "GitHub"
          ],
          "Reviewed Firebase workflow": [
            "This Linux host",
            "GitHub"
          ],
          "Release": [
            "GitHub"
          ]
        },
        "ios": [
          "GitHub"
        ]
      },
      "win32": {
        "macos": [
          "GitHub"
        ],
        "linux": [
          "GitHub"
        ],
        "windows": [
          "This Windows host",
          "GitHub"
        ],
        "android": {
          "Test": [
            "This Windows host \u2014 Android Emulator",
            "GitHub"
          ],
          "Build": [
            "This Windows host",
            "GitHub"
          ],
          "Prepare Firebase": [
            "This Windows host",
            "GitHub"
          ],
          "Reviewed Firebase workflow": [
            "This Windows host",
            "GitHub"
          ],
          "Release": [
            "GitHub"
          ]
        },
        "ios": [
          "GitHub"
        ]
      },
      "darwin": {
        "macos": [
          "This Mac",
          "GitHub"
        ],
        "linux": [
          "Local Parallels VM",
          "GitHub"
        ],
        "windows": [
          "Local Parallels VM",
          "GitHub"
        ],
        "ios": {
          "Test": [
            "This Mac \u2014 iOS Simulators",
            "GitHub"
          ],
          "Prepare TestFlight": [
            "This Mac",
            "GitHub"
          ],
          "Reviewed TestFlight workflow": [
            "This Mac",
            "GitHub"
          ],
          "Release": [
            "GitHub"
          ]
        },
        "android": {
          "Test": [
            "This Mac \u2014 Android Emulator",
            "GitHub"
          ],
          "Build": [
            "This Mac",
            "GitHub"
          ],
          "Prepare Firebase": [
            "This Mac",
            "GitHub"
          ],
          "Reviewed Firebase workflow": [
            "This Mac",
            "GitHub"
          ],
          "Release": [
            "GitHub"
          ]
        }
      }
    },
    "operations_by_target": {
      "macos": [
        "Test",
        "Release"
      ],
      "linux": [
        "Test",
        "Release"
      ],
      "windows": [
        "Test",
        "Release"
      ],
      "ios": [
        "Test",
        "Prepare TestFlight",
        "Reviewed TestFlight workflow",
        "Release"
      ],
      "android": [
        "Test",
        "Build",
        "Prepare Firebase",
        "Reviewed Firebase workflow",
        "Release"
      ]
    },
    "providers": [
      "github",
      "firebase",
      "testflight"
    ]
  },
  "run_options": {
    "include_ipad": {
      "label": "Include sequential iPad coverage",
      "default": false
    }
  },
  "account_fields": {
    "testflight": "auth.testflight_reference",
    "github": {
      "reference": "auth.github_reference",
      "kind": "auth.github_kind"
    }
  },
  "presets": {
    "Local macOS validation": {
      "operation": "Test",
      "platform": "macos",
      "backend": "This Mac"
    },
    "iOS tester preparation": {
      "operation": "Prepare TestFlight",
      "platform": "ios",
      "backend": "This Mac"
    },
    "Android tester preparation": {
      "operation": "Prepare Firebase",
      "platform": "android",
      "backend": "This Mac"
    },
    "Reviewed TestFlight distribution": {
      "operation": "Reviewed TestFlight workflow",
      "platform": "ios",
      "backend": "This Mac"
    },
    "Reviewed Firebase distribution": {
      "operation": "Reviewed Firebase workflow",
      "platform": "android",
      "backend": "This Mac"
    },
    "Portable tooling contracts": {
      "platform": "macos",
      "operation": "Test",
      "backend": "This Mac",
      "suite": "portable.contracts"
    },
    "Desktop application and UI": {
      "platform": "macos",
      "operation": "Test",
      "backend": "This Mac",
      "suite": "desktop.ui"
    }
  },
  "test_suites": [
    {
      "id": "portable.contracts",
      "label": "Portable tooling contracts",
      "tier": "contracts",
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "operations": [
        "Test"
      ],
      "description": "Project tooling contracts in isolated host processes; no native device evidence."
    },
    {
      "id": "desktop.ui",
      "label": "Desktop application and UI",
      "tier": "ui",
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "operations": [
        "Test"
      ],
      "description": "Application tests in isolated Qt host processes."
    },
    {
      "id": "android.native",
      "label": "Android native UI",
      "tier": "native",
      "platforms": [
        "android"
      ],
      "operations": [
        "Test"
      ],
      "description": "Canonical native UI inventory on an owned disposable emulator."
    },
    {
      "id": "android.runtime",
      "label": "Android runtime contracts",
      "tier": "native",
      "platforms": [
        "android"
      ],
      "operations": [
        "Test"
      ],
      "description": "Canonical core inventory in the actual Android Python runtime."
    },
    {
      "id": "ios.native",
      "label": "iOS native UI sequence",
      "tier": "native",
      "platforms": [
        "ios"
      ],
      "operations": [
        "Test"
      ],
      "description": "Canonical iPhone/Duo and optional iPad inventory with owned cleanup."
    },
    {
      "id": "ios.runtime",
      "label": "iOS runtime contracts",
      "tier": "native",
      "platforms": [
        "ios"
      ],
      "operations": [
        "Test"
      ],
      "description": "Canonical core inventory in pinned CPython on an owned disposable iOS simulator."
    },
    {
      "id": "release.acceptance",
      "label": "Complete tester delivery gates",
      "tier": "acceptance",
      "platforms": [
        "ios",
        "android"
      ],
      "operations": [
        "Reviewed TestFlight workflow",
        "Reviewed Firebase workflow"
      ],
      "description": "Full native/runtime gates, preparation, and a separately reviewed upload. Cannot be narrowed."
    }
  ],
  "journey": {
    "schema": 1,
    "platforms": {
      "macos": {
        "label": "macOS",
        "operation": "Test",
        "backend": "This Mac"
      },
      "linux": {
        "label": "Linux (configured distributions)",
        "operation": "Test",
        "backend": "Local Parallels VM",
        "backends_by_host": {
          "linux": "This Linux host"
        }
      },
      "windows": {
        "label": "Windows",
        "operation": "Test",
        "backend": "Local Parallels VM",
        "backends_by_host": {
          "win32": "This Windows host"
        }
      },
      "ios": {
        "label": "iOS (native UI and runtime)",
        "operation": "Test",
        "backend": "This Mac \u2014 iOS Simulators"
      },
      "android": {
        "label": "Android (native UI and runtime)",
        "operation": "Test",
        "backend": "This Mac \u2014 Android Emulator",
        "backends_by_host": {
          "linux": "This Linux host \u2014 Android Emulator",
          "win32": "This Windows host \u2014 Android Emulator"
        }
      }
    },
    "destinations": {
      "github": {
        "label": "GitHub source release and hosted gates",
        "platforms": [
          "macos",
          "linux",
          "windows"
        ],
        "description": "Publishes a channel tag from the clean reviewed checkout; hosted release ZIP is separate from locally signed tester packages.",
        "category": "Source releases",
        "source_policy": "clean-checkout"
      },
      "firebase": {
        "label": "Firebase \u00b7 Android testers",
        "platforms": [
          "android"
        ],
        "description": "Prepares one verified package, then pauses before upload to the configured group.",
        "category": "Mobile tester platforms",
        "package": "android-release",
        "source_policy": "committed"
      },
      "testflight": {
        "label": "TestFlight \u00b7 iOS testers",
        "platforms": [
          "ios"
        ],
        "description": "Requires complete iPhone, Duo, iPad and runtime gates; pauses before uploading the prepared archive.",
        "category": "Mobile tester platforms",
        "package": "testflight-export",
        "source_policy": "committed"
      },
      "android-devices": {
        "label": "Android test devices",
        "platforms": [
          "android"
        ],
        "category": "Mobile dev devices",
        "description": "Choose Debug for development or Release to share the tester build. Review each installation; signing/version conflicts stop the update.",
        "recipient_field": "devices.android",
        "package_field": "devices.android_variant",
        "package_default": "debug",
        "package_variants": {
          "debug": "android-debug",
          "release": "android-release"
        },
        "testing_optional": true
      },
      "ios-devices": {
        "label": "iPhone / iPad",
        "platforms": [
          "ios"
        ],
        "category": "Mobile dev devices",
        "description": "Choose Debug for development or Release to share the tester build. Review each installation; signing/version conflicts stop the update.",
        "recipient_field": "devices.ios",
        "package_field": "devices.ios_variant",
        "package_default": "debug",
        "package_variants": {
          "debug": "ios-debug",
          "release": "ios-device-export"
        },
        "testing_optional": true
      }
    },
    "selectable_backends": true,
    "unavailable_destinations": [
      {
        "label": "App Store and Play Store",
        "category": "Mobile stores",
        "reason": "Store submission is not implemented by this project. Use tester platforms or development devices."
      }
    ],
    "packages": {
      "android-release": {
        "label": "Build & sign Android Release APK",
        "description": "Shared signed APK \u00b7 Firebase and Release devices",
        "stage": "build",
        "platforms": [
          "android"
        ],
        "source_policy": "committed"
      },
      "ios-release": {
        "label": "Build iOS Release archive",
        "description": "Shared compiled archive",
        "stage": "build",
        "platforms": [
          "ios"
        ],
        "source_policy": "committed"
      },
      "testflight-export": {
        "label": "Export & sign for TestFlight",
        "description": "App Store distribution provisioning",
        "stage": "package",
        "platforms": [
          "ios"
        ],
        "dependencies": [
          "ios-release"
        ]
      },
      "ios-device-export": {
        "label": "Export & sign iOS Release for devices",
        "description": "Existing device provisioning \u00b7 no recompilation",
        "stage": "package",
        "platforms": [
          "ios"
        ],
        "dependencies": [
          "ios-release"
        ]
      },
      "android-debug": {
        "label": "Build Android Debug APK",
        "description": "Development variant \u00b7 separate from Release",
        "stage": "build",
        "platforms": [
          "android"
        ]
      },
      "ios-debug": {
        "label": "Build & sign iOS Debug app",
        "description": "Development variant \u00b7 separate from Release",
        "stage": "build",
        "platforms": [
          "ios"
        ]
      }
    }
  },
  "run_fields": [
    {
      "id": "devices.android_signing",
      "label": "Android Debug package signing",
      "kind": "choice",
      "default": "debug",
      "options": {
        "debug": "Android Debug key",
        "beta": "Existing Logistics Beta key"
      },
      "destinations": [
        "android-devices"
      ],
      "description": "Select the existing Beta key when updating a Beta-signed main app. Signing happens before artifact review; installation never changes signing or clears data. Release packages retain their existing signature."
    },
    {
      "id": "devices.android_connections",
      "label": "Android connection overrides",
      "kind": "text",
      "destinations": [
        "android-devices"
      ],
      "description": "Optional JSON object mapping selected hardware IDs to explicit ADB serials for this run. Hardware identity is verified before installation; saved settings are preserved."
    },
    {
      "id": "testers.message",
      "label": "Message for testers (Firebase and TestFlight)",
      "kind": "multiline",
      "destinations": [
        "firebase",
        "testflight"
      ],
      "description": "One message for both tester services. Leave untouched to keep each saved service default."
    },
    {
      "id": "testflight.what_to_test",
      "label": "What should TestFlight testers try?",
      "kind": "multiline",
      "operations": [
        "Prepare TestFlight",
        "Reviewed TestFlight workflow"
      ],
      "description": "Notes for this build only. Describe what changed and what to try."
    },
    {
      "id": "testflight.external_group",
      "label": "TestFlight recipient group",
      "kind": "text",
      "destinations": [
        "testflight"
      ],
      "operations": [
        "Prepare TestFlight",
        "Reviewed TestFlight workflow"
      ],
      "description": "Uses the saved group unless you choose another group for this build."
    },
    {
      "id": "firebase.release_notes",
      "label": "What should Android testers try?",
      "kind": "multiline",
      "operations": [
        "Prepare Firebase",
        "Reviewed Firebase workflow"
      ],
      "description": "Release notes for this build only."
    },
    {
      "id": "firebase.group",
      "label": "Firebase recipient group",
      "kind": "text",
      "destinations": [
        "firebase"
      ],
      "operations": [
        "Prepare Firebase",
        "Reviewed Firebase workflow"
      ],
      "description": "Uses the saved group unless you choose another group for this build."
    },
    {
      "id": "devices.android",
      "label": "Android devices",
      "kind": "multiselect",
      "destinations": [
        "android-devices"
      ],
      "description": "Select saved devices or enter a paired device ID. No automatic discovery or installation happens here."
    },
    {
      "id": "devices.ios",
      "label": "iPhones and iPads",
      "kind": "multiselect",
      "destinations": [
        "ios-devices"
      ],
      "description": "Select saved devices or enter a paired device ID. No automatic discovery or installation happens here."
    },
    {
      "id": "devices.android_variant",
      "label": "Android package",
      "kind": "choice",
      "default": "debug",
      "options": {
        "debug": "Debug \u00b7 development build",
        "release": "Release \u00b7 reuse tester build"
      },
      "destinations": [
        "android-devices"
      ],
      "description": "Release requires committed source and full release gates. Existing signing and app data are preserved; incompatible updates stop."
    },
    {
      "id": "devices.ios_variant",
      "label": "iPhone / iPad package",
      "kind": "choice",
      "default": "debug",
      "options": {
        "debug": "Debug \u00b7 development build",
        "release": "Release \u00b7 reuse tester build"
      },
      "destinations": [
        "ios-devices"
      ],
      "description": "Release requires committed source and full release gates. Existing signing and app data are preserved; incompatible updates stop."
    }
  ],
  "dynamic_run_inputs": true
}
